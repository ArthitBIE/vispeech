{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "nvidia/nemotron-3-super-120b-a12b:free": {}
      },
      "options": {
        "websearch_cited": {
          "model": "nvidia/nemotron-3-super-120b-a12b:free"
        }
      }
    }
  },
  "autoupdate": true,
  "tools": {
    "webfetch": true
  },
  "plugin": [
    "@dietrichgebert/ponytail@latest",
    "@zenobius/opencode-skillful@latest",
    "@plannotator/opencode@latest",
    "@oh-my-opencode-slim@latest"
  ],
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--caps=network,storage,testing,vision,pdf,devtools"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "lsp": true,
  "formatter": true,
  "permission": {
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm *": "allow",
      "rm *": "deny",
      "grep *": "allow"
    },
    "external_directory": {
      "~/Document/*": "allow"
    }
  },
  "command": {
    "pr": {
      "description": "Create a GitHub PR from current branch with unpushed commits",
      "template": "{file:.opencode/commands/pr.md}\n\n$ARGUMENTS"
    },
    "review-pr": {
      "description": "Review PR changes with structured checklist",
      "template": "{file:.opencode/commands/review-pr.md}\n\n$ARGUMENTS"
    },
    "hookify": {
      "description": "Create hooks to prevent unwanted behaviors",
      "template": "{file:.opencode/commands/hookify.md}\n\n$ARGUMENTS"
    },
    "hookify-configure": {
      "description": "Enable or disable hookify rules interactively",
      "template": "{file:.opencode/commands/hookify-configure.md}\n\n$ARGUMENTS"
    },
    "hookify-help": {
      "description": "Get help with the hookify system",
      "template": "{file:.opencode/commands/hookify-help.md}\n\n$ARGUMENTS"
    },
    "hookify-list": {
      "description": "List all configured hookify rules",
      "template": "{file:.opencode/commands/hookify-list.md}\n\n$ARGUMENTS"
    },
    "setup-pre-commit": {
      "description": "Set up Husky pre-commit hooks with lint-staged, type checking, and tests",
      "template": "{file:.opencode/commands/setup-pre-commit.md}\n\n$ARGUMENTS"
    }
  }
}